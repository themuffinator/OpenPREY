{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Regenerate openPREY Launch Configurations",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\generate-launch.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Configure openPREY (Meson Debug)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\meson-task.ps1",
        "setup"
      ],
      "problemMatcher": []
    },
    {
      "label": "Compile openPREY (Meson Debug)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\meson-task.ps1",
        "compile"
      ],
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Stage openPREY Install Tree (Meson Debug)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\meson-task.ps1",
        "install"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build openPREY (Meson Debug)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\meson-task.ps1",
        "fastbuild"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Full Build and Stage openPREY (Meson Debug)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Configure openPREY (Meson Debug)",
        "Compile openPREY (Meson Debug)",
        "Stage openPREY Install Tree (Meson Debug)"
      ],
      "problemMatcher": []
    }
  ]
}
