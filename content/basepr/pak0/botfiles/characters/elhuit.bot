// Elhuit kept the Hidden alive inside the Sphere and built an escape around
// stolen portal technology. She fights like a planner: control a route, deny
// it, and preserve the larger operation.
character "Elhuit" {
	inherit		"ambusher"
	description	"Hidden resistance leader who turns routes into prepared ground"
	skillBand	3 5
	modelNum	16

	set	combatRange		820
