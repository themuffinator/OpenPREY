	reply farewell {
		priority 20
		source any
		addressed either
		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"
		trigger "take care"
		"Goodbye, $other."
		"Go in peace."
		"Take care of yourself."
		"Until we meet again."
	}
	reply direct {
		priority 0
		source any
		addressed required
		trigger "Mutilated Human"
		trigger "Mutilated Human respond"
		trigger "Mutilated Human report"
		trigger "Mutilated Human status"
		trigger "Mutilated Human listen"
		trigger "Mutilated Human answer"
		trigger "Mutilated Human come in"
		trigger "Mutilated Human are you there"
		"I am here, $other."
		"Speak. I am listening."
		"You called. I answer."
		"My attention is yours."
